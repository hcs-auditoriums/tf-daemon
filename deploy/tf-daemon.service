# systemd unit template for tf-daemon.
# Don't copy this by hand: deploy/install-service.sh fills in @USER@ and @DIR@
# and installs it to /etc/systemd/system/tf-daemon.service.

[Unit]
Description=tf-daemon spectrum analyzer for Yamaha TF5
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
# ALSA devices are root:audio 0660 and the tinySA's /dev/ttyACM* is root:dialout
# 0660; the service user needn't be in either group.
SupplementaryGroups=audio dialout
WorkingDirectory=@DIR@
Environment=TF_DAEMON_CONFIG=@DIR@/config.toml
Environment=TF_DAEMON_SOURCE=device
ExecStart=@DIR@/.venv/bin/gunicorn -c gunicorn.conf.py tf_daemon.wsgi:app
Restart=on-failure
RestartSec=3
# Audio capture benefits from a little scheduling priority.
Nice=-5

[Install]
WantedBy=multi-user.target
