# systemd unit for tf-daemon on the Raspberry Pi.
# Install:
#   sudo cp deploy/tf-daemon.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now tf-daemon
# Adjust User / WorkingDirectory if the repo isn't at /home/pi/tf-daemon.

[Unit]
Description=tf-daemon spectrum analyzer for Yamaha TF5
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=audio
WorkingDirectory=/home/pi/tf-daemon
Environment=TF_DAEMON_CONFIG=/home/pi/tf-daemon/config.toml
Environment=TF_DAEMON_SOURCE=device
ExecStart=/home/pi/tf-daemon/.venv/bin/gunicorn -c gunicorn.conf.py tf_daemon.wsgi:app
Restart=on-failure
RestartSec=3
# Audio capture benefits from a little scheduling priority.
Nice=-5

[Install]
WantedBy=multi-user.target
